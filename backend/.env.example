NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Session signing key, at least 32 random characters (Render generates one)
JWT_SECRET=change-me-to-64-random-characters-change-me-to-64-random-chars
SESSION_TTL_HOURS=12
# Neon direct connection string (dev branch locally, main in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
